# =====================================================================
# Plantilla para producción con Docker Compose (servidor propio +
# Cloudflare Tunnel). Copia este archivo como ".env.production" en la
# RAÍZ del proyecto (junto a docker-compose.yml, no dentro de backend/)
# y completa los valores reales. ".env.production" nunca debe subirse
# a Git.
#
# Diferencias importantes contra backend/.env.example (instalación
# local sin Docker):
#   - DB_HOST debe ser "db" (el nombre del servicio en
#     docker-compose.yml), no "127.0.0.1" — el contenedor "web" no ve
#     "localhost" como el MySQL del host, se conecta al contenedor "db"
#     por la red interna de Docker usando ese nombre.
#   - Hacen falta DB_ROOT_PASSWORD y CLOUDFLARE_TUNNEL_TOKEN, que no
#     existen en backend/.env.example porque solo aplican al stack de
#     Docker (MySQL corriendo en contenedor propio, y el túnel de
#     Cloudflare), no a una instalación local con MySQL ya instalado
#     aparte.
# =====================================================================

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-unica-y-larga
DEBUG=False
ALLOWED_HOSTS=tu-subdominio.tudominio.com
CSRF_TRUSTED_ORIGINS=https://tu-subdominio.tudominio.com

# Base de datos — el contenedor "db" de docker-compose.yml usa
# DB_ROOT_PASSWORD para inicializar MySQL, y crea automáticamente el
# usuario/base con DB_NAME/DB_USER/DB_PASSWORD. El contenedor "web" se
# conecta a ese mismo MySQL usando DB_HOST=db.
DB_ENGINE=django.db.backends.mysql
DB_ROOT_PASSWORD=elige-una-contrasena-root-segura
DB_NAME=sigepan_db
DB_USER=sigepan_app
DB_PASSWORD=elige-una-contrasena-segura-para-este-usuario
DB_HOST=db
DB_PORT=3306

# Correo electrónico
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGEPAN <no-reply@sigepan.local>

# Google OAuth 2.0 (opcional). El redirect URI debe usar el dominio
# público real (https, sin puerto) y estar registrado tal cual en
# Google Cloud Console → APIs y servicios → Credenciales → tu Client ID
# → "URI de redireccionamiento autorizados". Si no coincide exactamente
# (incluyendo la barra final), Google rechaza el login con
# redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-subdominio.tudominio.com/security/perfil/google/callback/

# Cloudflare Tunnel — token del túnel creado en Cloudflare Zero Trust
# (Networks → Tunnels → Create a tunnel). Ver README para el paso a
# paso completo.
CLOUDFLARE_TUNNEL_TOKEN=
