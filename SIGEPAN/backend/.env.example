# =====================================================================
# Copia este archivo como ".env" en la misma carpeta y completa los
# valores reales. El archivo ".env" nunca debe subirse a Git.
# =====================================================================

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-unica
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos (MySQL 8.0 — proyecto Database First, ver database/ddl/)
DB_ENGINE=django.db.backends.mysql
DB_NAME=sigepan_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo electrónico
# Deja EMAIL_BACKEND en console.EmailBackend para solo imprimir los
# correos en la terminal (útil para probar sin credenciales reales).
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGEPAN <no-reply@sigepan.local>

# Google OAuth 2.0 (opcional — solo necesario para "Iniciar sesión con
# Google" y la exportación de reportes a Google Sheets). Se obtienen en
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/security/perfil/google/callback/
